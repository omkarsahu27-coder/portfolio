---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../lib/site';
import { getFeaturedProjects } from '../lib/content';

const featuredProjects = await getFeaturedProjects();
---

<BaseLayout title="Home">
  <!-- Section A: Hero -->
  <Section class="hero fade-in" padding="lg">
    <div class="hero-layout">
      <div class="hero-content">
        <div class="availability-pill">
          <span class="dot"></span>
          Available for work
        </div>
        <h1 class="hero-title">
          Hi, I'm <span class="accent">{site.name}</span>
        </h1>
        <p class="tagline">{site.tagline}</p>
        <p class="description text-muted">{site.description}</p>
        <div class="hero-ctas">
          <Button href="/projects">View Projects</Button>
          <Button variant="secondary" href="/contact">Get in Touch</Button>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="glow-orb"></div>
        <div class="grid-pattern"></div>
      </div>
    </div>
  </Section>

<!-- Section B: Featured Projects -->
  <Section id="work" padding="lg" class="reveal">
    <div class="section-header">
      <h2>Featured Projects</h2>
      <p class="text-muted">A few things I've built recently.</p>
    </div>
    
    {featuredProjects.length > 0 ? (
      <>
      <div class="project-grid">
        {featuredProjects.map((project, index) => (
          <div class="reveal" data-delay={(index % 3) * 100}>
            <ProjectCard project={project} featured={true} />
          </div>
        ))}
      </div>
      </>
      <div class="center-cta">
        <Button variant="secondary" href="/projects">See all projects</Button>
      </div>
    ) : (
      <div class="empty-state">
        <p class="text-muted">Projects coming soon — check back shortly.</p>
        <Button variant="ghost" href="/projects">View all projects &rarr;</Button>
      </div>
    )}
  </Section>

  <!-- Section C: Quick Stats -->
  <Section padding="lg">
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-value">{site.stats.yearsCoding}</span>
        <span class="stat-label text-muted">Years coding</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{site.stats.projectsShipped}</span>
        <span class="stat-label text-muted">Projects shipped</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{site.stats.techStackSize}</span>
        <span class="stat-label text-muted">Tech stack size</span>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    min-height: calc(100vh - var(--header-height) - 100px);
    justify-content: center;
  }
  
  @media (min-width: 768px) {
    .hero-layout {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .hero-content {
      flex: 1;
      max-width: 600px;
    }
    .hero-visual {
      flex: 1;
      display: flex;
      justify-content: flex-end;
    }
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: var(--space-6);
  }

  .dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px var(--accent);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  .accent {
    color: var(--accent);
  }

  .tagline {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .description {
    font-size: 1.125rem;
    max-width: 500px;
    margin-bottom: var(--space-8);
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  
  @media (min-width: 480px) {
    .hero-ctas {
      flex-direction: row;
    }
  }

  /* Abstract Visual */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    display: none;
  }
  
  @media (min-width: 768px) {
    .hero-visual { display: block; }
  }

  .glow-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    height: 70%;
    border-radius: var(--radius-full);
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    opacity: 0.15;
    filter: blur(40px);
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
  }

  /* Projects Section */
  .section-header {
    margin-bottom: var(--space-10);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .project-grid { grid-template-columns: repeat(2, 1fr); }
  }
  
  @media (min-width: 1024px) {
    .project-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .center-cta {
    display: flex;
    justify-content: center;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    background-color: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
  }

  /* Stats Section */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    border-top: 1px solid var(--border);
    padding-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
      text-align: center;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }
</style>