---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  canonicalURL = new URL(Astro.url.pathname, site.url).href,
  noindex = false,
  ogType = 'website'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | ${site.name}` : site.title;
const absoluteOgImage = new URL(ogImage, site.url).href;

// Base JSON-LD Person Schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.name,
  "url": site.url,
  "jobTitle": site.role,
  "description": site.tagline,
  "image": new URL("/me.jpg", site.url).href,
  "sameAs": Object.values(site.socials),
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Bilaspur",
    "addressRegion": "Chhattisgarh",
    "addressCountry": "IN"
  }
};

// Website Schema (Only on Home Page)
const isHome = Astro.url.pathname === '/';
const websiteSchema = isHome ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.name,
  "url": site.url,
  "description": site.description,
  "inLanguage": site.locale
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Title & Meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    {site.keywords.length > 0 && <meta name="keywords" content={site.keywords.join(', ')} />}

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    {site.twitterHandle && <meta name="twitter:creator" content={`@${site.twitterHandle}`} />}

    <!-- Performance: Preconnects & Preloads -->
    <link rel="preconnect" href="https://formspree.io" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/_astro/poppins-400.woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href="/_astro/poppins-600.woff2" crossorigin="anonymous" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}

    <!-- Vercel Analytics (Optional - uncomment to enable) -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <div class="layout-wrapper">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Scroll Animations -->
    <script>
      import { initReveal } from '../scripts/reveal.js';
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>