---
interface Props {
  href: string;
  label: string;
  external?: boolean;
}

const { href, label, external = false } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<a 
  href={href} 
  class:list={['nav-link', { active: isActive }]} 
  target={external ? '_blank' : undefined} 
  rel={external ? 'noopener noreferrer' : undefined}
>
  {label}
</a>

<style>
  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: var(--space-2) 0;
    position: relative;
    display: inline-block;
  }
  
  .nav-link:hover {
    color: var(--text);
  }
  
  .nav-link.active {
    color: var(--accent);
  }
  
  /* Subtle underline for active state */
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--accent);
    border-radius: var(--radius-full);
  }

  /* Adjustments for mobile view */
  :global(.mobile-nav) .nav-link {
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    min-height: 48px; /* Touch target size */
    width: 100%;
    padding: 0 var(--space-4);
  }
  
  :global(.mobile-nav) .nav-link.active::after {
    display: none;
  }
  
  :global(.mobile-nav) .nav-link.active {
    background-color: rgba(99, 102, 241, 0.1);
    border-left: 3px solid var(--accent);
  }
  /* Animated underline instead of instant border */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--accent);
    border-radius: var(--radius-full);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 200ms var(--ease-out);
  }

  .nav-link:hover { color: var(--text); }
  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  
  .nav-link.active::after {
    transform: scaleX(1);
  }
</style>